# ---------------------------------------------------------------------------
# Morse relay environment.
#
#   cp .env.example .env          # or: ./scripts/init-env.sh
#   ./scripts/gen-secrets.py dad  # writes firmware/src/secrets.h
#   ./scripts/gen-secrets.py emma
#
# .env is gitignored: it holds WiFi credentials and bearer tokens. Never commit
# it, paste it into an issue, or copy it into the repo.
#
# Quotes around values are optional and are stripped. Values may contain spaces,
# '#', '$', etc. when quoted.
# ---------------------------------------------------------------------------

# --- WiFi shared by both ESP32 boards --------------------------------------
# 2.4 GHz only: the ESP32 cannot join a 5 GHz-only SSID. Guest WiFi usually
# isolates clients, which breaks access to the relay.
WIFI_SSID="your-wifi-name"
WIFI_PASS="your-wifi-password"

# --- Cloudflare Worker relay ----------------------------------------------
# The Worker + Durable Object that replaced the laptop relay in 0.2.0
# (see worker/README.md). No laptop, no open port: the ESP32s talk to
# this URL over HTTPS from anywhere with internet.
# Local dev: http://localhost:8787 (make worker-dev).
# Production: the HTTPS URL of your Worker's custom domain, e.g.
# https://morse.example.com — `make worker-deploy` reads the host from this
# value and attaches it as a Workers Custom Domain (DNS + certificate).
MORSE_SERVER_URL="https://your-worker-domain.example"

# Optional: device display names (single words). Passed as --var on deploy;
# without them the Worker falls back to DAD / EMMA.
# MORSE_DAD_NAME="DAD"
# MORSE_EMMA_NAME="EMMA"

# --- Bearer tokens: one per device ----------------------------------------
# Generate with: openssl rand -hex 24
# The Worker maps device id "dad" to MORSE_TOKEN_DAD, "emma" to
# MORSE_TOKEN_EMMA (uppercase, '-' becomes '_'). The same tokens go in
# worker/.dev.vars (local dev) and `make worker-secrets` (production reads
# these values straight from this file). The two tokens must differ.
MORSE_TOKEN_DAD="REPLACE_WITH_openssl_rand_hex_24"
MORSE_TOKEN_EMMA="REPLACE_WITH_openssl_rand_hex_24"

# --- Optional: CORS origins for the sim ------------------------------------
# The sim runs on http://localhost:8077, which is allowed by default.
# Add more origins (comma-separated) only if you point the sim at the
# deployed Worker from another origin, e.g. "https://morse.example.com".
# MORSE_CORS_ORIGINS="https://morse.example.com"
